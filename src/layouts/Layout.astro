    <main style="padding: 2em;">
      <slot /> <!-- Aquí se inserta el contenido -->
    </main>

    <footer style="padding: 1em; text-align: center; background: #771edd41;">
      <p>Hecho por Karincillo el pillo</p>
    </footer>
  </body>
</html>
